# Copy to .env.local for local development. Never commit real values.
# Every provider block is all-or-nothing: leave a whole block empty to keep that
# integration off; filling only part of a block makes the server refuse to start.

# --- Core ---------------------------------------------------------------------
# Defaults to http://localhost:3000. Required (https) in production.
APP_BASE_URL=
# WF-01 local store (SQLite + uploaded files). Defaults to .data in the app dir.
SCL_DATA_DIR=
# No sign-in exists yet. Must be "true" to serve the dashboard outside
# development, and then only on a private network. Defaults to false.
DASHBOARD_ALLOW_UNAUTHENTICATED=

# --- Supabase: database, auth, storage (decision pending, see docs) -----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose to the browser.
SUPABASE_SECRET_KEY=

# --- n8n (existing SCL-workflows instance) ------------------------------------
# e.g. https://n8n.example.com/webhook
N8N_WEBHOOK_BASE_URL=
# Sent as the x-scl-token header. Server only.
N8N_WEBHOOK_TOKEN=

# --- Mux: approved video hosting and delivery (WF-07, WF-08, WF-10) -----------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- PostHog: analytics (WF-09) -----------------------------------------------
# Public by design: the project key is sent from the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# e.g. https://eu.i.posthog.com or https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# --- Runway: AI video generation (WF-07) --------------------------------------
RUNWAYML_API_SECRET=

# --- Veo via the Gemini API (WF-07). Flow is used manually through its UI. ---
GEMINI_API_KEY=

# --- SaveAllResources: Generate Website Template (primary path) ---------------
# The SaveAllResources installation Web runs as a separate process
# (docs/save-all-resources.md). Unset: the feature is off (in development a
# sibling ../SaveAllResources checkout is used if present).
SAR_HOME=
# Defaults for one generation (the form can override pages and depth).
SAR_MAX_PAGES=10
SAR_MAX_DEPTH=3
SAR_MAX_MINUTES=15

# --- Live template previews (docs/template-preview.md) -------------------------
# local: preview processes on this machine, viewed in a browser on this machine.
# remote: isolated preview servers (not available yet). off: disabled.
# Default: local in development, off otherwise.
PREVIEW_MODE=
PREVIEW_PORT_MIN=4310
PREVIEW_PORT_MAX=4399
PREVIEW_MAX_RUNNING=3
PREVIEW_IDLE_MINUTES=30

# --- SaveAllResources extension capture (alternative path): both or neither ---
# The automation build of the extension, built from its own repository with
# this Web origin (see docs/save-all-resources.md). The id is public; uploads
# are authorised per capture job with a short-lived token.
SAR_EXTENSION_ID=
# Where the extension uploads: this Web app's origin, e.g. https://web.example.com
SAR_UPLOAD_ORIGIN=
